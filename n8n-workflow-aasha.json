{
  "name": "Aasha WhatsApp Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aasha-whatsapp",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-userPhone",
              "leftValue": "={{ $json.userPhone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-phone",
      "name": "Has Phone Number?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const record = $input.first().json;\n\nconst message = `🔍 *Aasha Alert*\\n\\nA possible match has been found!\\n\\n` +\n  `*Name:* ${record.name}\\n` +\n  `*Age:* ${record.age}\\n` +\n  `*Camp:* ${record.campName}\\n` +\n  `*Record Type:* ${record.recordType}\\n\\n` +\n  `*Camp Officer:* ${record.officerName}\\n` +\n  `*Contact:* ${record.officerContact}\\n\\n` +\n  `Please contact the camp to verify.\\n\\n` +\n  `_This is an automated message from Aasha Disaster Reunification Platform._`;\n\nreturn [{ json: { ...record, message } }];"
      },
      "id": "build-message",
      "name": "Build WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.userPhone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.message) }}\n  }\n}",
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "WHATSAPP_API_TOKEN",
          "name": "WhatsApp API Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/api/webhook/n8n-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"savedSearchId\": \"{{ $json.savedSearchId }}\",\n  \"matchedRecordId\": \"{{ $json.recordId }}\",\n  \"matchedRecordType\": \"{{ $json.recordType }}\",\n  \"phoneNumber\": \"{{ $json.userPhone }}\",\n  \"status\": \"SENT\"\n}",
        "options": {}
      },
      "id": "log-success",
      "name": "Log Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/api/webhook/n8n-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"savedSearchId\": \"{{ $('Webhook Trigger').item.json.savedSearchId }}\",\n  \"matchedRecordId\": \"{{ $('Webhook Trigger').item.json.recordId }}\",\n  \"matchedRecordType\": \"{{ $('Webhook Trigger').item.json.recordType }}\",\n  \"phoneNumber\": \"{{ $('Webhook Trigger').item.json.userPhone }}\",\n  \"status\": \"FAILED\"\n}",
        "options": {}
      },
      "id": "log-failure",
      "name": "Log Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Has Phone Number?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Phone Number?": {
      "main": [
        [
          {
            "node": "Build WhatsApp Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build WhatsApp Message": {
      "main": [
        [
          {
            "node": "Send WhatsApp Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Message": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "aasha"
    }
  ]
}
